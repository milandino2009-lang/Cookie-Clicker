<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cookie Clicker</title>
    <link rel="stylesheet" href="style.css">
    <script src="script.js" defer></script>
</head>
<body>
<main class="game-layout">
    <section class="cookie-area">
        <h1>Cookie Clicker</h1>
        <button id="cookiebutton">Cookie!</button>
        <p id="cookiecount">0</p>
    </section>

    <aside class="shop-area">
        <h1>Upgrades</h1>
        <button id="upgrade">Upgrade klik: 50 cookies</button>
        <p id="upgradecount">0</p>

        <h1>Productie eenheden</h1>
        <button id="grandma">Grandma is 10 cookies</button>
        <p id="grandmacount">0</p>
        <button id="farm">farm is 400 cookies</button>
        <p id="farmcount">0</p>
        <button id="factory">Factory is 1000 cookies</button>
        <p id="factorycount">0</p>
    </aside>
</main>

</body>
</html>
